[Desktop Entry]
# The launcher entry the .deb installs into /usr/share/applications.
#
# Exec names `cutreel`, the symlink app/CMakeLists.txt puts in /usr/bin beside
# zaro-preview, so that what somebody types in a terminal and what the desktop
# runs are the same word. %f rather than %F: the app opens one project.
#
# The basename of this file, minus .desktop, is what
# QGuiApplication::setDesktopFileName is given in app/main.cpp. That is how the
# desktop matches a running window to this entry -- Qt writes it into WM_CLASS
# on X11 and reports it as the app id on Wayland -- and it is why the taskbar
# shows the icon and the name below rather than a grey square called
# "zaro-preview". Renaming this file means changing that call too.
Type=Application
Name=CutReel
GenericName=Video Editor
Comment=A non-linear video editor
Exec=cutreel %f
Icon=cutreel
Terminal=false
Categories=AudioVideo;Video;AudioVideoEditing;
Keywords=video;editor;editing;cut;timeline;nle;
StartupNotify=true
